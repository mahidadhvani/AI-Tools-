3. Optimize the generated image for React
-------------------------------------------
npm install sharp
const sharp = require("sharp");

async function optimizeImage() {
  await sharp("food-app-background.png")
    .resize({
      width: 1600,
      withoutEnlargement: true
    })
    .webp({
      quality: 75
    })
    .toFile("food-app-background.webp");

  console.log("Image converted to WebP successfully.");
}

optimizeImage();
