1. PlaylistCard.jsx — React functional component
-------------------------------------------------------------------------------------------------
import React from "react";

function PlaylistCard({ name, creator, songCount }) {
  return (
    <div className="playlist-card">
      <h2>{name}</h2>
      <p>Created by: {creator}</p>
      <p>{songCount} songs</p>
    </div>
  );
}

export default PlaylistCard;





<PlaylistCard
  name="Chill Vibes"
  creator="Arjun"
  songCount={25}
/>







2. Flipkart-style product card
