<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Myntra-Style Navbar</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
    }

    /* NAVBAR */
    .navbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 15px 5%;
      background-color: white;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    /* LOGO */
    .logo {
      font-size: 24px;
      font-weight: bold;
    }

    /* DESKTOP NAVIGATION */
    .nav-links {
      display: flex;
      gap: 30px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav-links a {
      text-decoration: none;
      color: #222;
      font-weight: bold;
    }

    /* HAMBURGER BUTTON */
    .menu-toggle {
      display: none;
      border: none;
      background: transparent;
      font-size: 28px;
      cursor: pointer;
    }

    /* MOBILE LAYOUT */
    @media (max-width: 768px) {

      .navbar {
        flex-wrap: wrap;
        padding: 12px 5%;
      }

      .menu-toggle {
        display: block;
      }

      .nav-links {
        display: none;
        width: 100%;
        flex-direction: column;
        gap: 0;
      }

      .nav-links.active {
        display: flex;
      }

      .nav-links li {
        border-top: 1px solid #ddd;
      }

      .nav-links a {
        display: block;
        padding: 15px 5px;
      }
    }
  </style>
</head>

<body>

  <!--
  PROMPT GIVEN TO CHATGPT:

  "Generate a responsive navigation bar for a Myntra-style fashion
  shopping app. Include Home, Explore, Cart, and Profile links.

  Desktop requirements:
  - Display the logo and all four navigation links horizontally.
  - Use comfortable spacing between links.
  - Keep the navigation bar clean and aligned.

  Mobile requirements:
  - Display a hamburger menu.
  - Hide the navigation links initially.
  - When the hamburger menu is clicked, display Home, Explore,
    Cart, and Profile vertically.
  - Make the layout responsive.

  Use semantic HTML, accessible labels, responsive CSS, and
  minimal JavaScript. Return a complete HTML snippet."
  -->

  <!-- NAVIGATION BAR -->
  <nav class="navbar" aria-label="Main navigation">

    <div class="logo">
      MYNTRA
    </div>

    <!-- MOBILE MENU BUTTON -->
    <button
      class="menu-toggle"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="nav-links">
      ☰
    </button>

    <!-- NAVIGATION LINKS -->
    <ul class="nav-links" id="nav-links">
      <li>
        <a href="#">Home</a>
      </li>

      <li>
        <a href="#">Explore</a>
      </li>

      <li>
        <a href="#">Cart</a>
      </li>

      <li>
        <a href="#">Profile</a>
      </li>
    </ul>

  </nav>

  <!-- JAVASCRIPT FOR MOBILE MENU -->
  <script>
    const menuButton = document.querySelector(".menu-toggle");
    const navLinks = document.querySelector("#nav-links");

    menuButton.addEventListener("click", function () {

      const isOpen = navLinks.classList.toggle("active");

      menuButton.setAttribute(
        "aria-expanded",
        isOpen
      );

      menuButton.setAttribute(
        "aria-label",
        isOpen
          ? "Close navigation menu"
          : "Open navigation menu"
      );
    });
  </script>

</body>
</html>
